PORT=5000
NODE_ENV=development

# Database (Supabase)
# Use DATABASE_URL for connection pooling (Transaction mode)
DATABASE_URL="postgresql://user:password@host:port/dbname?pgbouncer=true"
# Use DIRECT_URL for migrations (Session mode)
DIRECT_URL="postgresql://user:password@host:port/dbname"

# Auth (Dual Token)
JWT_ACCESS_SECRET="your_access_secret"
JWT_REFRESH_SECRET="your_refresh_secret"
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# Cloudinary
CLOUDINARY_CLOUD_NAME="your_cloud_name"
CLOUDINARY_API_KEY="your_api_key"
CLOUDINARY_API_SECRET="your_api_secret"

# Frontend URL for CORS
FRONTEND_URL=http://localhost:3000

# Seed
SEED_PASSWORD_PEMILIK="your_pemilik_password"
SEED_PASSWORD_ADMIN="your_admin_password"
